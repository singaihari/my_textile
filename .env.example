# Textile POS local (shop PC) configuration. Copy to .env — this file is outside the public web root.
# No passwords or API secrets belong here: the admin is created in first-time setup, and the
# sync device token is entered by an admin in Sync Center (stored in the local database).

APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=0

# SQLite database location (relative to the project folder, or absolute). Must NOT be inside public/.
DB_PATH=storage/sqlite/textile_pos.sqlite
