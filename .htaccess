# Safety net: the project root (app/, storage/, database/, .env, server-api/app) must never be web-accessible.
# Point the web server's DocumentRoot at ./public instead. Only public/ re-enables access.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
