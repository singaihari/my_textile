{
    "name": "textile/pos",
    "description": "Offline-first textile shop POS & inventory (Core PHP + SQLite) with manual sync to a Core PHP/MySQL API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-curl": "Needed for Sync Now (HTTPS client)",
        "ext-pdo_mysql": "Needed by server-api in production"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Server\\": "server-api/app/" }
    },
    "scripts": {
        "test": "php tests/run.php",
        "lint": "php scripts/lint.php",
        "migrate": "php scripts/run-migrations.php"
    }
}
