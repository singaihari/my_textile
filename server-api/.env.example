# Online sync API configuration. Copy to server-api/.env (outside the public web root) and fill in.
# Never commit the real .env.
APP_TIMEZONE=Asia/Kolkata

# Production: MySQL / MariaDB
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=textile_pos
DB_USER=textile_api
DB_PASS=change-me

# DB_DRIVER=sqlite is ONLY for automated tests / the local mock server:
# DB_SQLITE_PATH=storage/mock-server.sqlite

# Refuse plain HTTP except on localhost (keep 0 in production)
ALLOW_HTTP=0
